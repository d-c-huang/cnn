{
  "name": "ai-from-zero-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:api": "python -m unittest discover -s backend/tests -v",
    "test:playground": "node scripts/test-playground.mjs",
    "test:neuron": "node --experimental-strip-types scripts/test-neuron.mjs",
    "test:loss": "node --experimental-strip-types scripts/test-loss.mjs",
    "test:optimizers": "node --experimental-strip-types scripts/test-optimizers.mjs",
    "test:bundle": "node scripts/test-bundle.mjs",
    "test:foundations": "node --experimental-strip-types scripts/test-foundation-previews.mjs",
    "test:learning": "node --experimental-strip-types scripts/test-advanced-task-checks.mjs",
    "test:progress": "node --experimental-strip-types scripts/test-course-progress.mjs",
    "test:content": "node --experimental-strip-types scripts/test-lesson-content.mjs",
    "test:frontend": "npm run test:foundations && npm run test:neuron && npm run test:loss && npm run test:optimizers && npm run test:learning && npm run test:progress && npm run test:content && npm run test:records && npm run test:display && npm run test:sft && npm run test:dpo && npm run test:grpo && npm run test:playground",
    "check": "npm run test:frontend && npm run build && npm run test:bundle && npm run test:design",
    "lint:py": "ruff check backend scripts",
    "format:py": "ruff format backend scripts",
    "lint:web": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:records": "node --experimental-strip-types scripts/test-learning-records.mjs",
    "test:design": "node scripts/test-design-system.mjs",
    "test:display": "node --experimental-strip-types scripts/test-display-preferences.mjs",
    "test:sft": "node --experimental-strip-types scripts/test-sft-data.mjs",
    "test:dpo": "node --experimental-strip-types scripts/test-dpo-data.mjs",
    "test:grpo": "node --experimental-strip-types scripts/test-grpo-data.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lightningcss": "^1.33.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
